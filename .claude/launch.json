{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rticore-local",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev:local"],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "rticore-dev-sqlite-3100",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "set RTICORE_DB_ENGINE=sqlite&& node node_modules/next/dist/bin/next dev --webpack -H 127.0.0.1 -p 3100"],
      "port": 3100,
      "url": "http://127.0.0.1:3100"
    }
  ]
}
