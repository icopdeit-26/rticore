# Set in protected Hostinger application environment, never commit real values.
RTICORE_RUNTIME=hostinger
RTICORE_AUTH_MODE=business
RTICORE_LOCAL_MODE=0
RTICORE_DB_ENGINE=postgres
RTICORE_PUBLIC_ORIGIN=https://rticore.store
DATABASE_URL=postgresql://rticore_app:REPLACE@db.example.invalid/rticore?sslmode=verify-full
RTICORE_IAM_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64
RTICORE_AI_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_KEY
RTICORE_DOCUMENT_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_KEY
# PORT is assigned by managed hosting. Do not hardcode it.
