# Template only. Replace example.invalid and certificate paths before nginx -t.
server {
 listen 443 ssl;
 server_name rticore.example.invalid;
 ssl_certificate /etc/letsencrypt/live/rticore.example.invalid/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/rticore.example.invalid/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 add_header Strict-Transport-Security "max-age=31536000" always;
 location = /oauth2/auth {
  internal;
  proxy_pass http://127.0.0.1:4180;
  proxy_pass_request_body off;
  proxy_set_header Content-Length "";
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Original-URI $request_uri;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header Authorization "";
 }
 location /oauth2/ {
  proxy_pass http://127.0.0.1:4180;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Auth-Request-Redirect https://rticore.example.invalid/login;
  proxy_set_header Authorization "";
 }
 location = /api/health/live {
  proxy_pass http://127.0.0.1:3000;
  proxy_set_header X-RTICore-OIDC-Token "";
  proxy_set_header Host $host;
 }
 location / {
  auth_request /oauth2/auth;
  auth_request_set $oidc_token $upstream_http_x_auth_request_access_token;
  auth_request_set $session_cookie $upstream_http_set_cookie;
  add_header Set-Cookie $session_cookie;
  add_header Strict-Transport-Security "max-age=31536000" always;
  proxy_pass http://127.0.0.1:3000;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-RTICore-OIDC-Token $oidc_token;
  proxy_set_header Authorization "";
  proxy_set_header CF-Access-JWT-Assertion "";
 }
 # Login bootstrap is a proxy sign-in redirect, not a bypass to the app.
 error_page 401 = /oauth2/sign_in;
}
