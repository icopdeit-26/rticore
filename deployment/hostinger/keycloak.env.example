# Install a supported pinned Keycloak release and configure a dedicated database.
# Store outside the repository; mode 0600. Replace placeholders securely.
KC_HOSTNAME=https://sso.example.invalid
KC_HTTP_ENABLED=true
KC_HTTP_HOST=127.0.0.1
KC_HTTP_PORT=8080
KC_PROXY_HEADERS=xforwarded
KC_PROXY_TRUSTED_ADDRESSES=127.0.0.1
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://identity-db.example.invalid/keycloak?sslmode=verify-full
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=REPLACE_WITH_DEDICATED_SECRET
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=false
