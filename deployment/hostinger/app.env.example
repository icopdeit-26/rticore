# Copy outside git; owner root, readable only by the intended service. Replace all placeholders.
RTICORE_RUNTIME=hostinger
RTICORE_LOCAL_MODE=0
RTICORE_DB_ENGINE=postgres
HOSTNAME_BIND=127.0.0.1
PORT=3000
RTICORE_PUBLIC_ORIGIN=https://rticore.example.invalid
RTICORE_OIDC_ISSUER=https://sso.example.invalid/realms/rticore
RTICORE_OIDC_CLIENT_ID=rticore-proxy
RTICORE_OIDC_AUDIENCE=rticore-api
RTICORE_OIDC_CLIENT_SECRET=REPLACE_WITH_GENERATED_SECRET
DATABASE_URL=postgresql://rticore_app:REPLACE@db.example.invalid/rticore?sslmode=verify-full
# Re-provision existing application encryption secrets separately; do not rotate blindly.
