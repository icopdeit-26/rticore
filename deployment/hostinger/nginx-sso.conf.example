# Dedicated public SSO virtual host; administrative access is not exposed.
server {
 listen 443 ssl;
 server_name sso.example.invalid;
 ssl_certificate /etc/letsencrypt/live/sso.example.invalid/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/sso.example.invalid/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 add_header Strict-Transport-Security "max-age=31536000" always;
 add_header X-Content-Type-Options "nosniff" always;
 location ~ ^/(realms/rticore/|resources/) {
  proxy_pass http://127.0.0.1:8080;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Port 443;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header Forwarded "";
  proxy_set_header X-Real-IP $remote_addr;
 }
 location / { return 404; }
}
