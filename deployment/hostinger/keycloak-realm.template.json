{
  "realm": "rticore",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": true,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clients": [
    {
      "clientId": "rticore-api",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "rticore-proxy",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://rticore.example.invalid/oauth2/callback"
      ],
      "webOrigins": [
        "https://rticore.example.invalid"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://rticore.example.invalid/login",
        "default.acr.values": "2",
        "minimum.acr.value": "2"
      },
      "protocolMappers": [
        {
          "name": "rticore-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "rticore-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "implicitFlowEnabled": false,
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr"
      ],
      "optionalClientScopes": []
    }
  ],
  "browserFlow": "rticore-required-mfa",
  "authenticationFlows": [
    {
      "alias": "rticore-required-mfa",
      "description": "Mandatory password and OTP at LoA 2; no cookie or broker bypass",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "rticore-password-otp-loa2",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10
        }
      ]
    },
    {
      "alias": "rticore-password-otp-loa2",
      "description": "Record LoA 2 only after password and OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "rticore-loa2",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30
        }
      ]
    }
  ],
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "rememberMe": false,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "authenticatorConfig": [
    {
      "alias": "rticore-loa2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0"
      }
    }
  ]
}
