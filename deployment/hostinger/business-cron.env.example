# Protected runtime configuration; never commit credentials.
RTICORE_RUNTIME=hostinger
RTICORE_AUTH_MODE=business
RTICORE_LOCAL_MODE=0
RTICORE_SALES_CRON_ENABLED=0
RTICORE_IAM_CLEANUP_ENABLED=0
RTICORE_SALES_CRON_DATABASE_URL=postgresql://sales_cron:REPLACE@db.example.invalid/rticore?sslmode=verify-full
RTICORE_IAM_CLEANUP_DATABASE_URL=postgresql://iam_cleanup:REPLACE@db.example.invalid/rticore?sslmode=verify-full
RTICORE_SALES_CRON_EXPECTED_DATABASE=rticore
RTICORE_IAM_CLEANUP_EXPECTED_DATABASE=rticore
